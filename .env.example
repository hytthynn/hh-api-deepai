# hh-api — локальный шлюз. Скопируйте в .env.local и заполните HH_SECRET.
# Без HH_SECRET приложение не стартует.

HH_PORT=3210
HH_HOST=127.0.0.1

# Режим развёртывания (ADR-025):
#   full    — всё локально: закупка, регистрация, шлюз, UI (по умолчанию);
#   gateway — только шлюз и UI (Railway): регистрация недоступна, аккаунты
#             переносятся файлом («Настройки → Данные → Файл переноса»).
HH_MODE=full
# Публичный origin развёрнутого экземпляра: добавляется в CSRF-allowlist,
# при https сессионная cookie получает флаг Secure. Пример:
# HH_PUBLIC_ORIGIN=https://hh.example.up.railway.app
# Порт платформы (Railway injectит PORT сам). HH_PORT/HH_HOST имеют приоритет;
# при PORT без HH_HOST сервер слушает 0.0.0.0.
# PORT=8080

# 32+ случайных байта в base64. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
HH_SECRET=

# Пароль входа в UI. Пусто — вход в панель недоступен, пока пароль не задан в настройках.
HH_ADMIN_PASSWORD=

HH_DB_PATH=./data/hh.db
HH_ENGINE_DIR=./engine
# Python-воркер: путь к python и Chrome (пусто — автопоиск Chrome + Chromium из Playwright)
HH_PYTHON=python
# HH_CHROME=C:/Program Files/Google/Chrome/Application/chrome.exe

HH_LOG_RETENTION_DAYS=14
HH_REQUEST_RETENTION_DAYS=90
HH_DEFAULT_RPM=60

HH_UPSTREAM_TIMEOUT_MS=300000
HH_SLOT_WAIT_MS=45000

# debug | info | warn | error — уровень записи в таблицу logs и stdout
HH_LOG_LEVEL=info

# 1 — измерять Theos до/после каждого запроса (медленнее, для отладки)
HH_MEASURE_THEOS=0

# 1 — писать тела запросов в requests.detail (может содержать пользовательские данные)
HH_DEBUG_BODY=0

# 1 — разрешить слушать не только 127.0.0.1 (по умолчанию запрещено)
HH_ALLOW_REMOTE=0

# Служебный флаг тестового окружения, вручную не выставлять
HH_TEST_MODE=0